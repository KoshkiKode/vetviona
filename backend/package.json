{
  "name": "vetviona-license-backend",
  "version": "1.0.0",
  "description": "Vetviona paid-license backend \u2014 account registration, email verification, and license verification.",
  "private": true,
  "main": "license_server.js",
  "scripts": {
    "start": "node license_server.js",
    "check": "node --check license_server.js",
    "test": "node test/server_test.js",
    "test:coverage": "c8 --reporter=text --reporter=cobertura npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "nodemailer": "^10.2.1",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "c8": {
    "all": true,
    "src": [
      "lib",
      "license_server.js"
    ],
    "exclude": [
      "test/**"
    ],
    "reports-dir": "coverage"
  },
  "keywords": [
    "vetviona",
    "license",
    "koshkikode"
  ],
  "author": "KoshkiKode",
  "license": "UNLICENSED"
}
