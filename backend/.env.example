# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── License database (local file — dev only) ──────────────────────────────────
# Leave LICENSE_DB_PATH unset to use the default: backend/license-db.json
# This is ignored when S3_BUCKET is set.
# LICENSE_DB_PATH=/path/to/license-db.json

# ── S3-Compatible Object Storage (production) ─────────────────────────────────
# Set S3_BUCKET to switch from local file storage to any S3-compatible provider.
# Works with MinIO (self-hosted), Backblaze B2, Cloudflare R2, Hetzner, etc.
#
# S3_BUCKET=vetviona-licenses
# S3_KEY=vetviona/license-db.json
# S3_REGION=us-east-1
#
# S3_ENDPOINT is required for non-default providers:
#   MinIO (local):   S3_ENDPOINT=http://localhost:9000
#   Backblaze B2:    S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   Cloudflare R2:   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT=
#
# Credentials — standard env var names used by all S3-compatible SDKs:
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production — protects the voucher-creation endpoint.
# If unset, a random secret is generated and printed to the console at startup.
# ADMIN_SECRET=

# REQUIRED in production when using object storage.
# Must be a stable random string of >= 32 characters.
# If unset, auto-generated and persisted in the DB (works for local-file dev).
# LICENSE_KEY_SECRET=

# Maximum verified devices per license type per account (default: 15)
# MAX_DEVICES_PER_LICENSE=15

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset to run in dev mode: tokens are logged to the console
# and returned in API responses.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=Vetviona <noreply@vetviona.app>
