<?xml version="1.0" encoding="utf-8"?>
<!--
  Vetviona is a private, local-first app: family trees, medical notes and
  pairing secrets must never be uploaded to a cloud backup. Users move data
  with the in-app encrypted backup or RootLoop sync instead.
  (Used by Android 11 and below. allowBackup is also false in the manifest.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
